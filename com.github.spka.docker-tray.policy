<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Docker Tray</vendor>
  <vendor_url>https://github.com/spka/docker-tray</vendor_url>

  <action id="com.github.spka.docker-tray.read">
    <description>Read Docker status for Docker Tray</description>
    <message>Authentication is required to read Docker status</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/docker-tray/docker_tray_privileged.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">read</annotate>
  </action>

  <action id="com.github.spka.docker-tray.watch">
    <description>Monitor Docker status for Docker Tray</description>
    <message>Authentication is required to monitor Docker status</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/docker-tray/docker_tray_privileged.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">watch</annotate>
  </action>

  <action id="com.github.spka.docker-tray.write">
    <description>Manage Docker containers from Docker Tray</description>
    <message>Authentication is required to change Docker containers</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/docker-tray/docker_tray_privileged.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">write</annotate>
  </action>
</policyconfig>
